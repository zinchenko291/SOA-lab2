:80 {
    handle /api/v1/space-marines* {
        reverse_proxy collection-service:8081
    }

    handle /api/v1/starship* {
        reverse_proxy starship-service:8082
    }

    handle /api/* {
        respond "Unknown API service" 404
    }

    handle {
        reverse_proxy host.docker.internal:3000
    }
}
