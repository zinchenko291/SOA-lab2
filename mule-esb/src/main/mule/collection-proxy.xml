<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:tls="http://www.mulesoft.org/schema/mule/tls"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
          http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
          http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
          http://www.mulesoft.org/schema/mule/tls http://www.mulesoft.org/schema/mule/tls/current/mule-tls.xsd">

    <http:listener-config name="collectionProxyListener">
        <http:listener-connection host="0.0.0.0" port="8084"/>
    </http:listener-config>

    <configuration-properties file="upstreams.properties"/>

    <tls:context name="upstreamTls">
        <tls:trust-store path="${UPSTREAM_TRUSTSTORE}" type="${UPSTREAM_TRUSTSTORE_TYPE}" password="changeit"/>
    </tls:context>

    <http:request-config name="collectionHttps">
        <http:request-connection protocol="HTTPS" host="${COLLECTION_HOST}"
                                 port="${COLLECTION_PORT}" tlsContext="upstreamTls"/>
    </http:request-config>

    <http:request-config name="collectionHttp">
        <http:request-connection host="${COLLECTION_HOST}" port="${COLLECTION_PORT}"/>
    </http:request-config>

    <flow name="getCollectionMarine">
        <http:listener config-ref="collectionProxyListener" path="/api/v1/space-marines/{id}" allowedMethods="GET">
            <http:response statusCode="#[attributes.statusCode]">
                <http:headers><![CDATA[#[attributes.headers.'content-type' match {
                    case contentType is String -> {'Content-Type': contentType}
                    else -> {}
                }]]]></http:headers>
            </http:response>
        </http:listener>
        <set-variable variableName="requestPath" value="#[attributes.requestPath]"/>
        <set-variable variableName="requestStartedAt" value="#[now() as Number {unit: 'milliseconds'}]"/>
        <http:request config-ref="${COLLECTION_REQUEST_CONFIG}" method="GET" path="/api/v1/space-marines/{id}"
                      responseTimeout="4000" followRedirects="false">
            <http:uri-params>#[{id: attributes.uriParams.id}]</http:uri-params>
            <http:response-validator>
                <http:success-status-code-validator values="200..599"/>
            </http:response-validator>
        </http:request>
        <logger level="INFO" category="soa.integration"
                message="[http] service=mule-esb from=starship-service to=collection-service method=GET
                         path=#[vars.requestPath] status=#[attributes.statusCode]
                         duration_ms=#[(now() as Number {unit: 'milliseconds'}) - vars.requestStartedAt]
                         correlation_id=#[correlationId]"/>
        <error-handler>
            <on-error-propagate type="ANY">
                <logger level="ERROR" category="soa.integration"
                        message="[http] service=mule-esb from=starship-service to=collection-service method=GET
                                 path=#[vars.requestPath] error=#[error.errorType.namespace]:#[error.errorType.identifier]
                                 duration_ms=#[(now() as Number {unit: 'milliseconds'}) - vars.requestStartedAt]
                                 correlation_id=#[correlationId]"/>
            </on-error-propagate>
        </error-handler>
    </flow>
</mule>
